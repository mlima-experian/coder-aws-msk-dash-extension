{
  "name": "vscode-msk-kafka",
  "displayName": "MSK Kafka Dashboard",
  "version": "0.0.1",
  "publisher": "exp.mlima",
  "description": "Extensão para conectar ao MSK Kafka com suporte a AssumeRole.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlima-experian/coder-aws-msk-dash-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mskKafka.openDashboard",
        "title": "MSK Kafka: Abrir Dashboard",
        "icon": "$(dashboard)"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "aws-msk-iam-sasl-signer-js": "^1.0.3",
    "kafkajs": "^2.2.4"
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "package": "vsce package"
  }
}
