{
    "name": "vscode-msk-kafka",
    "displayName": "MSK Kafka Dashboard",
    "version": "0.0.7",
    "publisher": "mlima-exp",
    "description": "Extensão para conectar ao MSK Kafka com suporte a AssumeRole.",
    "repository": {
        "type": "git",
        "url": "https://github.com/mlima-experian/coder-aws-msk-dash-extension"
    },
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#1d1c1c",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.134.0"
    },
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "AWS MSK",
            "properties": {
                "awsMsk.consumerGroupPrefix": {
                    "type": "string",
                    "default": "vscode-msk",
                    "description": "Prefixo do consumer group usado para ler mensagens. Ajuste caso a policy IAM do MSK restrinja os group ids permitidos (kafka-cluster:AlterGroup / DescribeGroup)."
                },
                "awsMsk.fetchTimeoutMs": {
                    "type": "number",
                    "default": 30000,
                    "description": "Tempo máximo (ms) aguardando mensagens antes de encerrar a leitura."
                },
                "awsMsk.maxMessages": {
                    "type": "number",
                    "default": 10,
                    "description": "Quantidade máxima de mensagens recentes lidas por tópico."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "msk-explorer",
                    "title": "AWS MSK",
                    "icon": "images/icon.svg"
                }
            ]
        },
        "views": {
            "msk-explorer": [
                {
                    "id": "msk-clusters-view",
                    "name": "Clusters Cadastrados",
                    "icon": "images/icon.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "aws-msk.registerCluster",
                "title": "MSK: Cadastrar Cluster"
            },
            {
                "command": "aws-msk.getMessages",
                "title": "MSK: Obter Mensagens de Tópico"
            },
            {
                "command": "aws-msk.refreshClusters",
                "title": "Atualizar",
                "icon": "$(refresh)"
            },
            {
                "command": "aws-msk.deleteCluster",
                "title": "Excluir Cluster",
                "icon": "$(trash)"
            },
            {
                "command": "aws-msk.showTopicMetadata",
                "title": "MSK: Ver Metadados do Tópico",
                "icon": "$(info)"
            },
            {
                "command": "aws-msk.truncateTopic",
                "title": "MSK: Truncar Tópico",
                "icon": "$(clear-all)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "aws-msk.refreshClusters",
                    "when": "view == msk-clusters-view",
                    "group": "navigation"
                },
                {
                    "command": "aws-msk.registerCluster",
                    "when": "view == msk-clusters-view",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "aws-msk.deleteCluster",
                    "when": "view == msk-clusters-view && viewItem == msk-cluster",
                    "group": "inline"
                },
                {
                    "command": "aws-msk.getMessages",
                    "when": "view == msk-clusters-view && viewItem == msk-cluster",
                    "group": "inline"
                },
                {
                    "command": "aws-msk.showTopicMetadata",
                    "when": "view == msk-clusters-view && viewItem == msk-topic",
                    "group": "inline@1"
                },
                {
                    "command": "aws-msk.truncateTopic",
                    "when": "view == msk-clusters-view && viewItem == msk-topic",
                    "group": "inline@2"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@types/vscode": "^1.134.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2",
        "ovsx": "^1.1.1"
    },
    "dependencies": {
        "aws-msk-iam-sasl-signer-js": "^1.0.3",
        "kafkajs": "^2.2.4"
    },
    "scripts": {
        "compile": "tsc -p ./",
        "package": "vsce package"
    }
}
